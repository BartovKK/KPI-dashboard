      "_odata_example": {
        "source": "odata",
        "entity": "Document_РеализацияТоваровУслуг",
        "filter": "Posted eq true and Date ge datetime'{date_from}T00:00:00' and Date le datetime'{date_to}T23:59:59'",
        "expand": "Менеджер",
        "map": {
          "id": "Ref_Key",
          "manager": "Менеджер/Description",
          "dt": "Date",
          "doc": "Number",
          "revenue": "СуммаДокумента",
          "cost": "СебестоимостьДокумента",
          "signed": "ОригиналПолучен"
        }
      },
      "_csv_example": { "source": "csv", "file": "imports/sales.csv", "delimiter": ";" }
    }
  },

